AgentsConfigScreen {
    align: center middle;
}

#ac-container {
    width: 95%;
    min-width: 60;
    max-width: 120;
    height: 85%;
    max-height: 60;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 0;
}

/* Main horizontal layout */
#ac-main {
    height: 1fr;
}

/* Left sidebar */
#ac-sidebar {
    width: 28;
    height: 1fr;
    border-right: solid $tui-border-foreground 15%;
}

#ac-list {
    height: 1fr;
    border: none;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
}

/* Right panel */
#ac-right {
    width: 1fr;
    height: 1fr;
}

/* Tabs */
#ac-tabs {
    height: 1fr;
}

#ac-tabs ContentSwitcher {
    height: 1fr;
}

#ac-tabs TabPane {
    height: 1fr;
    padding: 0;
}

/* Compact buttons inside tab panes */
#ac-tabs Button {
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
}

/* The ACP row-delete buttons pin `width: 3`. The generic padding above would
   squeeze their content box below the label plus Button's line-pad, and
   Textual then emits strips whose declared cell_length undercounts their
   cells — the compositor shifts the rest of the row and paints past the
   panel edge. Any fixed-width Button in a tab pane needs this exemption. */
#ac-tabs .acp-row-delete {
    padding: 0;
}

/* Select styling inside tabs */
#ac-tabs Select {
    height: auto;
}

#ac-tabs SelectCurrent {
    height: 1;
    border: none;
    background: $foreground 8%;
    padding: 0 1;
}

#ac-tabs SelectOverlay {
    height: auto;
    max-height: 16;
    border: round $tui-border-primary $border-opacity;
    background: $surface;
}

/* Compact checkboxes inside tab panes */
#ac-tabs Checkbox {
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
}

/* Footer buttons */
#ac-footer {
    dock: bottom;
    height: 3;
    padding: 0 1;
    background: $surface;
}

#ac-footer.-read-only {
    height: 4;
}

#ac-buttons {
    width: 100%;
    height: 3;
    align: left middle;
    padding: 0;
    background: $surface;
}

#ac-buttons Button {
    min-width: 0;
    width: auto;
}

#ac-buttons #ac-new {
    margin: 0 1 0 0;
    min-width: 10;
    width: auto;
}

#ac-buttons #ac-clone {
    margin: 0 1 0 0;
    min-width: 10;
    width: auto;
}

#ac-buttons #ac-reset,
#ac-buttons #ac-delete {
    margin: 0 1 0 0;
    min-width: 10;
    width: auto;
}

#ac-buttons-spacer {
    width: 1fr;
    height: 1;
    background: transparent;
}

#ac-read-only-notice {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0 1;
    color: $warning;
    background: $warning 15%;
}

#ac-buttons #ac-save {
    margin: 0 1 0 0;
    min-width: 13;
}

#ac-buttons #ac-cancel {
    margin: 0;
    min-width: 13;
}
