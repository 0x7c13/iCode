RuntimeDetailsDialog {
    align: center middle;
    background: $background 40%;
}

#runtime-details-container {
    width: 92%;
    max-width: 100;
    height: 85%;
    max-height: 40;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 0;
}

#runtime-details-tabs {
    height: 1fr;
}

#runtime-details-tabs ContentSwitcher {
    height: 1fr;
}

#runtime-details-tabs TabPane {
    height: 1fr;
    padding: 0;
}

.runtime-detail-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
}

.runtime-detail-section {
    width: 100%;
    height: auto;
    border: round $tui-border-primary 45%;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-align: right;
    border-subtitle-color: $primary;
    margin: 0 1 1 0;
    padding: 0 1;
    color: $text;
}
