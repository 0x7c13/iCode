ToolDetailModal {
    align: center middle;
    background: $background 40%;
}

#tool-view-container {
    width: 92%;
    max-width: 120;
    height: 85%;
    max-height: 45;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $primary;
    background: $surface;
    padding: 0;
}

#tool-view-tabs {
    height: 1fr;
}

#tool-view-tabs ContentSwitcher {
    height: 1fr;
}

#tool-view-tabs TabPane {
    height: 1fr;
    padding: 0;
}

.tool-view-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
}

#tool-view-output > AgentTranscriptSurface {
    width: 100%;
    height: 1fr;
    padding: 0 0 0 1;
}
