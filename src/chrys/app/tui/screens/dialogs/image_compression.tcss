ImageCompressionDialog {
    align: center middle;
}

#image-compression-container {
    width: 42;
    max-width: 90%;
    height: auto;
    min-height: 5;
    background: $surface;
    border: round $tui-border-warning $border-opacity;
    border-title-color: $warning;
    border-title-style: bold;
}

#image-compression-inner {
    width: 100%;
    height: 3;
    align: center middle;
    background: $surface;
    padding: 1 1;
}

#image-compression-loading {
    width: auto;
    height: 1;
    color: $warning;
}
