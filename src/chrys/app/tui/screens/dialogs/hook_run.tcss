HookRunModal {
    align: center middle;
    background: $background 40%;
}

#hook-run-container {
    width: 92%;
    max-width: 120;
    height: 85%;
    max-height: 45;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    padding: 0;
}

#hook-run-tabs {
    height: 1fr;
}

#hook-run-tabs ContentSwitcher {
    height: 1fr;
}

#hook-run-tabs TabPane {
    height: 1fr;
    padding: 0;
}

.hook-run-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
}

/* Boxed as Runtime Details' sections; a box copies itself on a click, and the mouse over it shows which. */
.hook-run-section {
    width: 100%;
    height: auto;
    border: round $tui-border-primary 45%;
    border-title-color: $primary;
    border-title-style: bold;
    margin: 0 1 1 0;
    padding: 0 1;
    color: $text;
    pointer: pointer;
}

.hook-run-section.-hover {
    background: $boost;
    border: round $tui-border-primary;
}

.hook-run-note {
    color: $text-muted;
}

#hook-run-log {
    height: auto;
    max-height: 12;
    scrollbar-size: 1 1;
    background: transparent;
}
