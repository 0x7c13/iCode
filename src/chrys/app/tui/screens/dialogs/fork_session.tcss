ForkSessionDialog {
    align: center middle;
}

#fork-session-container {
    width: 58;
    height: auto;
    min-height: 8;
    border: round $tui-border-warning $border-opacity;
    border-title-color: $warning;
    border-title-style: bold;
}

#fork-session-inner {
    width: 100%;
    height: auto;
    min-height: 6;
    background: $surface;
}

#fork-session-loading {
    width: 100%;
    height: 1;
    color: $warning;
    margin: 1 0 0 0;
}

#fork-session-message {
    width: 100%;
    height: auto;
    min-height: 1;
    content-align: center middle;
    text-align: center;
    margin: 1 0;
}

#fork-session-buttons {
    dock: bottom;
    align: center top;
    height: 3;
    padding: 0 1;
}

#fork-session-buttons > Button {
    margin: 0 1;
}

#fork-session-error-buttons {
    dock: bottom;
    align: center top;
    height: 3;
    padding: 0 1;
}

#fork-session-error-buttons > Button {
    margin: 0 1;
}

ForkSessionDialog.-success #fork-session-container {
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
}

ForkSessionDialog.-success #fork-session-loading {
    color: $success;
}

ForkSessionDialog.-error #fork-session-container {
    border: round $tui-border-error $border-opacity;
    border-title-color: $error;
}

ForkSessionDialog.-error #fork-session-loading {
    color: $error;
}
