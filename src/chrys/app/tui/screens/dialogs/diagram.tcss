DiagramDialog {
    align: center middle;
    background: $background 40%;
}

#diagram-container {
    width: 94%;
    max-width: 140;
    height: 90%;
    max-height: 50;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-align: right;
    border-subtitle-color: $primary;
    background: $surface;
    padding: 0;
}

#diagram-viewport {
    width: 100%;
    height: 1fr;
    background: $surface;
}
