ApprovalDialog {
    align: center middle;
    background: $background 40%;
}

#approval-container {
    width: 120;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    background: $surface;
    border: round $tui-border-warning $border-opacity;
    border-title-color: $warning;
    border-title-style: bold;
}

#approval-inner {
    scrollbar-color: $warning;
    scrollbar-color-hover: $warning;
    scrollbar-color-active: $warning;
}

#approval-footer {
    dock: bottom;
    width: 100%;
    height: auto;
}

#approval-tool {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    margin: 1 0 0 0;
}

#approval-detail {
    width: 100%;
    height: auto;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    margin: 1 2 0 2;
}

/* Remote-chosen title under the bridged-request header; single line,
   informational only — the arg boxes below carry the authoritative text. */
#approval-remote-title {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    text-overflow: ellipsis;
    margin: 0 2;
}

#approval-args {
    width: 100%;
    height: auto;
    margin: 1 1 0 1;
    padding: 0;
}

.approval-arg-box {
    width: 100%;
    height: auto;
    border: round $tui-border-warning 50%;
    border-title-align: left;
    border-title-color: $warning;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

.approval-diff-preview {
    width: 100%;
    height: auto;
    border: round $tui-border-warning 50%;
    border-title-align: left;
    border-title-color: $warning;
    border-subtitle-align: right;
    border-subtitle-color: $text-muted;
    padding: 0 0;
    margin: 1 1 0 1;
}

.approval-diff-preview .approval-diff-placeholder {
    width: 100%;
    height: 3;
    content-align: center middle;
    color: $text-muted;
}

.approval-diff-preview DiffView {
    width: 100%;
    height: auto;
}

.approval-diff-preview CodeColumn {
    overflow-y: hidden;
    scrollbar-size-vertical: 0;
}

.approval-sub-agent-prompt {
    width: 100%;
    height: auto;
    border: round $tui-border-warning 50%;
    border-title-align: left;
    border-title-color: $warning;
    padding: 0 1;
    margin: 1 1 0 1;
}

.approval-sub-agent-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#approval-sub-agent-prompt-input {
    width: 100%;
    height: 16;
    max-height: 30;
    border: round $tui-border-accent $border-opacity;
}

#approval-separator {
    height: 1;
    margin: 0 1 0 1;
    color: $text-muted 30%;
    overflow: hidden;
}

App:ansi #approval-separator {
    color: $text-disabled;
}

#approval-judge {
    width: 100%;
    height: auto;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $tui-border-warning 50%;
    border-title-align: left;
    border-title-color: $warning;
    border-title-style: bold;
}

#approval-judge.judge-flagged {
    border: round $tui-border-error 50%;
    border-title-color: $error;
    color: $error;
}

#approval-judge-loading {
    width: 100%;
    height: 1;
    color: $warning;
}

#approval-concern {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1;
}

#approval-reason {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 7;
    border: round $tui-border-accent $border-opacity;
    margin: 1 1 0 1;
}

#approval-buttons {
    width: 100%;
    align: center top;
    height: 3;
    padding: 0 1 0 1;
}

#approval-buttons > Button {
    margin: 0 1;
}
