EditorDialog {
    align: center middle;
}

#editor-dialog {
    width: 90%;
    min-width: 40;
    max-width: 140;
    height: 90%;
    min-height: 14;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-subtitle-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 1 2 0 2;
}

#editor-dialog.editor-mode-emacs {
    border: round $tui-border-accent $border-opacity;
    border-title-color: $accent;
    border-subtitle-color: $accent;
}

#editor-dialog.editor-mode-vim {
    border: round $tui-border-success $border-opacity;
    border-title-color: $success;
    border-subtitle-color: $success;
}

#editor-header {
    width: 100%;
    height: 1;
    align-vertical: middle;
}

#editor-mode-label {
    width: auto;
    height: 1;
    margin-right: 1;
}

#editor-mode {
    width: 14;
    height: 1;
}

#editor-mode SelectCurrent {
    height: 1;
    border: none;
    background: $foreground 8%;
    padding: 0 1;
}

#editor-hint {
    width: 1fr;
    height: 1;
    margin-left: 2;
    color: $text-muted;
    content-align: right middle;
}

#message-editor {
    width: 100%;
    height: 1fr;
    border: none;
    background: $foreground 5%;
    padding: 0;
    margin: 1 0 0 0;
    scrollbar-size-vertical: 1;
}

#message-editor:focus {
    border: none;
    background: $foreground 8%;
}

#message-editor .text-area--cursor-line {
    background: $primary 15%;
}

#message-editor .text-area--selection {
    background: $foreground;
    color: $background;
    text-style: none;
}

#message-editor:ansi .text-area--selection {
    background: $ansi-foreground;
    color: $ansi-background;
}

#editor-actions {
    dock: bottom;
    width: 100%;
    height: 3;
    align-vertical: middle;
}

#editor-status {
    width: 1fr;
    height: 3;
    color: $secondary;
    content-align: left middle;
}

#editor-status-label {
    width: auto;
    height: 3;
    margin-right: 1;
    color: $text-muted;
    content-align: left middle;
}

#editor-status.editor-status-warning {
    color: $warning;
}

#editor-actions > Button {
    margin-left: 1;
}

#editor-dialog.editor-narrow {
    width: 100%;
    min-width: 30;
    height: 100%;
    padding: 0 1;
}

#editor-dialog.editor-narrow #editor-mode {
    width: 12;
}
