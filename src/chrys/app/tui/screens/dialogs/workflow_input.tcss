WorkflowInputDialog { align: center middle; }

WorkflowInputDialog #workflow-input-dialog {
    width: 90%; max-width: 104; height: auto; max-height: 95%;
    border: round $tui-border-primary $border-opacity;
    background: $surface; padding: 1 1 0 1;
    border-title-color: $primary; border-title-style: bold;
}

WorkflowInputDialog #workflow-input-body {
    height: auto; max-height: 100%; scrollbar-size-vertical: 1;
}

WorkflowInputDialog #workflow-input-identity { height: 1; margin: 0 1; }
WorkflowInputDialog #workflow-input-title {
    width: 1fr; text-style: bold; text-wrap: nowrap; text-overflow: ellipsis;
}
WorkflowInputDialog #workflow-input-source { width: auto; margin-left: 2; color: $text-muted; }
WorkflowInputDialog #workflow-input-description { height: auto; color: $text-muted; margin: 1 1 0 1; }

WorkflowInputDialog .workflow-input-section {
    height: auto; margin-top: 1; padding: 1 2 0 2;
    border: round $tui-border-foreground 15%;
    border-title-color: $secondary; border-title-style: bold;
}

WorkflowInputDialog .workflow-input-setting { height: 1; margin-bottom: 1; }
WorkflowInputDialog .workflow-input-setting-label { width: 18; height: 1; margin-right: 2; }
WorkflowInputDialog #workflow-input-directory {
    width: 1fr; height: 1; text-wrap: nowrap; text-overflow: ellipsis;
    color: $text-muted;
}
WorkflowInputDialog #workflow-input-change-directory {
    min-width: 10; width: auto; height: 1; margin-left: 1;
    border: none; padding: 0 1; background: $secondary 18%; color: $secondary; text-style: bold;
    content-align: center middle; text-align: center;
}
WorkflowInputDialog #workflow-input-change-directory:focus,
WorkflowInputDialog #workflow-input-change-directory.-active { background: $secondary 18%; color: $secondary; }
WorkflowInputDialog #workflow-input-change-directory:hover { background: $secondary 28%; color: $secondary; }
WorkflowInputDialog #workflow-input-directory-notice,
WorkflowInputDialog #workflow-input-directory-error { height: auto; margin-bottom: 1; }
WorkflowInputDialog #workflow-input-directory-notice { color: $text-muted; }
WorkflowInputDialog #workflow-input-directory-error { color: $error; }
WorkflowInputDialog #workflow-input-directory-loading {
    display: none; height: auto; margin-bottom: 1; color: $secondary;
}

WorkflowInputDialog #workflow-input-model { width: 1fr; height: auto; margin: 0; }
WorkflowInputDialog #workflow-input-model > SelectCurrent {
    height: 1; border: none; background: $foreground 8%; padding: 0 1;
}
WorkflowInputDialog #workflow-input-model:focus > SelectCurrent { border: none; background: $foreground 12%; }
WorkflowInputDialog #workflow-input-model > SelectOverlay {
    height: auto; max-height: 16; padding: 0 0 0 1;
    border: round $tui-border-primary $border-opacity; background: $surface;
}

WorkflowInputDialog #workflow-input-hint { height: auto; margin-bottom: 1; color: $text-muted; }
WorkflowInputDialog MessageEditor {
    height: 7; border: none; background: $foreground 5%; padding: 0 0 0 1; margin-bottom: 1;
}
WorkflowInputDialog MessageEditor:focus { border: none; background: $foreground 8%; }
WorkflowInputDialog MessageEditor .text-area--cursor-line { background: $primary 15%; }
WorkflowInputDialog MessageEditor .text-area--selection {
    background: $foreground; color: $background; text-style: none;
}
WorkflowInputDialog MessageEditor:ansi .text-area--selection {
    background: $ansi-foreground; color: $ansi-background;
}

WorkflowInputDialog #workflow-input-actions { align: right middle; padding: 0 1; margin-top: 1; }
WorkflowInputDialog #workflow-input-actions > Button { margin: 0 0 0 1; }
