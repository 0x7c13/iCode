FilePicker {
    align: center middle;
}

FilePicker > #fsd-container {
    width: 80%;
    max-width: 110;
    height: 75%;
    background: $surface;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    overflow-x: hidden;
}

FilePicker #fsd-body {
    width: 100%;
    height: 1fr;
}

FilePicker #fsd-sidebar {
    width: 30;
    height: 100%;
}

FilePicker #fsd-tabs {
    height: 100%;
}

FilePicker #fsd-tabs ContentSwitcher {
    height: 1fr;
}

FilePicker #fsd-tabs TabPane {
    padding: 0;
    height: 1fr;
}

FilePicker #fsd-tabs OptionList {
    height: 100%;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
}

FilePicker #fsd-tree {
    width: 1fr;
    height: 100%;
    scrollbar-size: 1 1;
    border-left: solid $tui-border-primary-darken-2 $border-opacity;
}

FilePicker #fsd-buttons {
    height: 3;
    padding: 0 1;
    align: right middle;
}

FilePicker #fsd-path-bar {
    width: 1fr;
    height: 2;
    padding: 1 1 0 1;
    color: $text-muted;
    content-align: left middle;
    overflow: hidden;
}

FilePicker #fsd-buttons > Button {
    margin: 0 1;
}

FilePicker #fsd-buttons > #fsd-cancel {
    margin-right: 0;
}
