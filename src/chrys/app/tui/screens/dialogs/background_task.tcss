BackgroundTaskModal {
    align: center middle;
    background: $background 40%;
}

#background-task-container {
    width: 92%;
    max-width: 120;
    height: 85%;
    max-height: 45;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    padding: 0;
}

#background-task-tabs {
    height: 1fr;
}

#background-task-tabs ContentSwitcher {
    height: 1fr;
}

#background-task-tabs TabPane {
    height: 1fr;
    padding: 0;
}

.background-task-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
}

#background-task-fields {
    margin: 1 0 0 0;
}

#background-task-log {
    height: 1fr;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
    background: $surface;
}
