ConfirmDialog {
    align: center middle;
}

ConfirmDialog > Tooltip {
    max-width: 90%;
}

ConfirmDialog #confirm-container {
    width: 43;
    height: auto;
    max-width: 90%;
    max-height: 90%;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
}

ConfirmDialog #confirm-inner {
    width: 100%;
    height: auto;
    background: $surface;
}

ConfirmDialog #confirm-message, ConfirmDialog #confirm-impact {
    width: 100%;
    height: auto;
    min-height: 1;
    content-align: center middle;
    text-align: center;
    margin: 1 0;
    padding: 0 2;
}

ConfirmDialog.-left-message #confirm-message {
    content-align: left middle;
    text-align: left;
}

ConfirmDialog .confirm-scroll {
    height: auto;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;
}

ConfirmDialog .confirm-scroll > TaskSummary {
    margin: 0 2 1 2;
}

ConfirmDialog #confirm-buttons {
    dock: bottom;
    align: center top;
    height: 3;
    padding: 0 1 0 1;
}

ConfirmDialog #confirm-buttons > Button {
    margin: 0 1;
}

/* Variant: warning-colored border */
ConfirmDialog.-warning-border #confirm-container {
    border: round $tui-border-warning $border-opacity;
    border-title-color: $warning;
}
