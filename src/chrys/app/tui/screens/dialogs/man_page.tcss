ManPageDialog {
    align: center middle;
    background: $background 40%;
}

#man-container {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    min-height: 8;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
}

#man-title {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#man-content {
    width: 100%;
    padding: 1;
}

#man-footer {
    width: 100%;
    height: 1;
    content-align: right middle;
    text-align: right;
    color: $text-muted;
    padding: 0 1;
}
